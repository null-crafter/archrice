{
  "disable_ai": false,
  "context_servers": {
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "ollama",
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
    },
    "ollama": {
      "model": "deepseek-v4-flash",
      "api_url": "https://ollama.com",
    },
  },
  "agent_buffer_font_size": 19.0,
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "language_models": {
    "ollama": {
      "api_url": "https://ollama.com",
    },
    "opencode": {
      "show_zen_models": false,
      "show_free_models": false,
    },
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "enable_feedback": false,
    "default_profile": "write",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Warm Charmed Icons",
    "dark": "Catppuccin Mocha",
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_sign_in": false,
    "button_layout": "platform_default",
    "show_menus": false,
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "indent_guides": {
    "enabled": false,
  },
   "format_on_save": "off",
  "cursor_blink": false,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "project_panel": {
    "hide_root": true,
    "auto_fold_dirs": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
    "folder_indicator": "icon",
    "dock": "left",
  },
  "status_bar": {
    "show_active_file": true,
  },
  "window_decorations": "client",
  "which_key": {
    "enabled": true,
  },
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_size": 16.0,
  },
    "extend_comment_on_newline": false,
  "vim_mode": true,
  "centered_layout": {
    "right_padding": 0.15,
    "left_padding": 0.15,
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "ui_font_size": 19.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "Aura Soft Dark",
    "dark": "Aura Soft Dark",
  },

  "theme_overrides": {
    "Aura Soft Dark": {
      "panel.background": "#15141c",
      "panel.focused_border": "#4e466e",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      }
    }
  },

  "languages": {
    "Elixir": {
      "language_servers": [
        "elixir-ls",
      ],
    },
    "EEx": {
      "language_servers": [
        "elixir-ls",
      ],
    },
    "HEEx": {
      "language_servers": [
        "elixir-ls",
      ],
    },
  },
}
